# REIM configuration.
#
#   cp .env.example .env
#
# Every variable is optional; the defaults below match the values baked into
# reim/core/config.py. Copy this file, adjust what you need, and never commit
# the result — .env is git-ignored.
#
# THIS FILE MUST CONTAIN NO REAL SECRETS. The credentials here are local
# development placeholders only.

# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------
# local | test | ci | staging | production
REIM_ENVIRONMENT=local

# CRITICAL | ERROR | WARNING | INFO | DEBUG
REIM_LOG_LEVEL=INFO

# true emits JSON logs (use in containers and CI); false is human-readable.
REIM_LOG_JSON=false

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Must use the psycopg (v3) driver.
# When running through docker compose the host is `postgres`, not `localhost`.
REIM_DATABASE_URL=postgresql+psycopg://reim:reim@localhost:5432/reim

REIM_DATABASE_ECHO=false
REIM_DATABASE_POOL_SIZE=5
REIM_DATABASE_MAX_OVERFLOW=10

# Used only by the integration test suite. When set and REIM_DATABASE_URL is
# not, the tests reuse it for the application settings too.
# REIM_TEST_DATABASE_URL=postgresql+psycopg://reim:reim@localhost:55432/reim

# --------------------------------------------------------------------------
# Outbound HTTP (connectors)
# --------------------------------------------------------------------------
REIM_HTTP_TIMEOUT_SECONDS=30
REIM_HTTP_MAX_RETRIES=3
REIM_HTTP_RETRY_BACKOFF_SECONDS=1.0

# Identifies REIM to the official sources it queries. Keep it honest and
# contactable — several publishers ask for an identifiable agent.
REIM_HTTP_USER_AGENT=REIM/0.1.0 (Regional Economic Intelligence Monitor; +https://github.com/RobBravo/reim)

# --------------------------------------------------------------------------
# Catalog
# --------------------------------------------------------------------------
REIM_CATALOG_PATH=sources/catalog.yml
REIM_QUALITY_RULES_PATH=sources/quality_rules.yml

# --------------------------------------------------------------------------
# API
# --------------------------------------------------------------------------
REIM_API_TITLE=REIM API

# Set when the API is served under a path prefix by a reverse proxy.
REIM_API_ROOT_PATH=

# Comma-separated. Narrow this before exposing the API publicly.
REIM_CORS_ALLOW_ORIGINS=*
REIM_CORS_ALLOW_CREDENTIALS=false

REIM_DEFAULT_PAGE_SIZE=100
REIM_MAX_PAGE_SIZE=1000
REIM_MAX_EXPORT_ROWS=100000

# Exposes /metrics in Prometheus text format.
REIM_METRICS_ENABLED=true

# --------------------------------------------------------------------------
# docker compose only
# --------------------------------------------------------------------------
POSTGRES_USER=reim
POSTGRES_PASSWORD=reim
POSTGRES_DB=reim
POSTGRES_PORT=5432
REIM_API_PORT=8000
