# REIM configuration.
#
#   cp .env.example .env
#
# Every variable is optional; the defaults below match the values baked into
# reim/core/config.py. Copy this file, adjust what you need, and never commit
# the result — .env is git-ignored.
#
# THIS FILE MUST CONTAIN NO REAL SECRETS. The credentials here are local
# development placeholders only.

# --------------------------------------------------------------------------
# General
# --------------------------------------------------------------------------
# local | test | ci | staging | production
REIM_ENVIRONMENT=local

# CRITICAL | ERROR | WARNING | INFO | DEBUG
REIM_LOG_LEVEL=INFO

# true emits JSON logs (use in containers and CI); false is human-readable.
REIM_LOG_JSON=false

# --------------------------------------------------------------------------
# Database
# --------------------------------------------------------------------------
# Must use the psycopg (v3) driver.
# When running through docker compose the host is `postgres`, not `localhost`.
REIM_DATABASE_URL=postgresql+psycopg://reim:reim@localhost:5432/reim

REIM_DATABASE_ECHO=false
REIM_DATABASE_POOL_SIZE=5
REIM_DATABASE_MAX_OVERFLOW=10

# Used only by the integration test suite. When set and REIM_DATABASE_URL is
# not, the tests reuse it for the application settings too.
# REIM_TEST_DATABASE_URL=postgresql+psycopg://reim:reim@localhost:55432/reim

# --------------------------------------------------------------------------
# Outbound HTTP (connectors)
# --------------------------------------------------------------------------
REIM_HTTP_TIMEOUT_SECONDS=30
REIM_HTTP_MAX_RETRIES=3
REIM_HTTP_RETRY_BACKOFF_SECONDS=1.0

# Identifies REIM to the official sources it queries. Keep it honest and
# contactable — several publishers ask for an identifiable agent.
REIM_HTTP_USER_AGENT=REIM/0.1.0 (Regional Economic Intelligence Monitor; +https://github.com/RobBravo/reim)

# --------------------------------------------------------------------------
# Catalog
# --------------------------------------------------------------------------
REIM_CATALOG_PATH=sources/catalog.yml
REIM_QUALITY_RULES_PATH=sources/quality_rules.yml

# --------------------------------------------------------------------------
# API
# --------------------------------------------------------------------------
REIM_API_TITLE=REIM API

# Set when the API is served under a path prefix by a reverse proxy.
REIM_API_ROOT_PATH=

# A bare *, a comma-separated list, or a JSON array (e.g. '["https://a.com"]').
# Narrow this before exposing the API publicly.
REIM_CORS_ALLOW_ORIGINS=*
REIM_CORS_ALLOW_CREDENTIALS=false

REIM_DEFAULT_PAGE_SIZE=100
REIM_MAX_PAGE_SIZE=1000
REIM_MAX_EXPORT_ROWS=100000

# Exposes /metrics in Prometheus text format.
REIM_METRICS_ENABLED=true

# --------------------------------------------------------------------------
# API access — rate limiting
# --------------------------------------------------------------------------
# The API stays open even with this on: a missing key is never an error, and
# a key only raises your allowance. See README.md's "API keys and rate
# limiting" section. Off is not recommended for a public deployment.
REIM_RATE_LIMIT_ENABLED=true

# Requests allowed per window with no key presented.
REIM_RATE_LIMIT_ANONYMOUS=60

# Requests allowed per window with a valid key (`reim key create --label ...`).
REIM_RATE_LIMIT_KEYED=600

# Length of the fixed window, in seconds. Must be between 1 and 3600.
REIM_RATE_LIMIT_WINDOW_SECONDS=60

# How many reverse proxies you run sit in front of REIM. 0 (default) ignores
# X-Forwarded-For and counts the socket peer. Behind one proxy you run, set 1.
# Setting this higher than the number of proxies you actually run lets a
# client pick its own identity and escape limiting entirely — never guess high.
REIM_TRUSTED_PROXY_HOPS=0

# --------------------------------------------------------------------------
# Alerting
# --------------------------------------------------------------------------
# Webhook URL to receive alert digests. Unset disables delivery: the command
# still evaluates and reports, so alerting being unconfigured does not become
# a crash.
# Alert-delivery error messages name only the scheme, host and port: a Slack
# or Discord webhook carries its token in the path, so nothing below the host
# is printed. A URL that keeps failing is still logged in full by the ingestion
# HTTP layer on a retryable status, though — avoid a long-lived secret here if
# that layer's logs are shipped anywhere less trusted than this file.
# REIM_ALERT_WEBHOOK_URL=

# Minimum alert severity: info | warning | error | critical.
REIM_ALERT_SEVERITY_FLOOR=error

# Hours to wait before repeating a standing alert about the same condition
# on the same pipeline. Must be between 1 and 720.
REIM_ALERT_REPEAT_HOURS=24

# Hours a pipeline run is allowed to remain in the 'running' state before it is
# assumed to have been killed (and flagged as stuck). Must be between 1 and 168.
REIM_ALERT_STUCK_RUN_HOURS=6

# --------------------------------------------------------------------------
# docker compose only
# --------------------------------------------------------------------------
POSTGRES_USER=reim
POSTGRES_PASSWORD=reim
POSTGRES_DB=reim
POSTGRES_PORT=5432
REIM_API_PORT=8000
