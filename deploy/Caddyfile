# Caddy obtains and renews the certificate for REIM_DOMAIN by itself.
#
# It also writes X-Forwarded-For — measured, not assumed: Caddy was recreated
# once with REIM_TRUSTED_PROXY_HOPS=2 and sent one forged entry. Reading it at
# entries[-2] would have surfaced the forged value if Caddy had appended to
# what the client sent; instead the logged identity was Caddy's own peer
# again, which is only possible if the header reaching the api held exactly
# one entry. Caddy OVERWRITES X-Forwarded-For with the peer address it sees —
# it does not append to whatever a client sent, and nothing a client sends
# survives into it at all. That is the whole reason REIM_TRUSTED_PROXY_HOPS=1
# is correct in the compose file: entries[-1] is always Caddy's own peer, not
# a client-chosen value. Do not raise this past the number of proxies you
# actually run on the theory that a second hop would preserve a client's
# entry — overwriting, not appending, is what every hop here does.
{
	# Contact address for the ACME CA, from REIM_ACME_EMAIL (deploy/.env).
	# Quoted so an empty/unset value substitutes to an empty *argument*
	# rather than none at all — `email {$REIM_ACME_EMAIL}` with the variable
	# unset fails Caddyfile parsing ("wrong argument count") instead of
	# quietly omitting the option. Verified against this pinned build
	# (docker.io/library/caddy:2.11.4-alpine, `caddy adapt`): quoted-empty
	# adapts with no `email` key under `apps.tls`, and a populated value
	# adapts with that address on both configured ACME issuers.
	email "{$REIM_ACME_EMAIL}"
}

{$REIM_DOMAIN} {
	encode zstd gzip

	# The Prometheus scrape endpoint carries no authentication by design; the
	# metrics design put that out of scope on the grounds that a scrape
	# endpoint is restricted at the network. This is that restriction. Remove
	# it only if you have another way to keep it off the public internet.
	handle /metrics {
		respond 404
	}

	handle /metrics/ {
		respond 404
	}

	handle {
		# Caddy does not add this by default. docs/deployment.md's "limit
		# counts requests, not bytes" section points here for a byte budget;
		# left commented because that trade-off is accepted, not fixed (see
		# the spec's §3.2) — uncomment and pick a size to enable it.
		#
		# Read what it actually bounds before you do: max_size caps a request
		# body a client SENDS, before Caddy forwards it upstream. It does not
		# cap a response Caddy returns. export.csv is fetched with a bodiless
		# GET, so uncommenting this caps nothing about that endpoint — this
		# build ships no core directive that does (see docs/deployment.md).
		# request_body {
		# 	max_size 10MB
		# }
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"
		reverse_proxy api:8000
	}
}
