# Copy to deploy/.env and fill in — beside docker-compose.prod.yml, whose
# variables it supplies. Nothing here has a
# default: every one of these is a decision, and a wrong default is worse than
# a missing value that stops the stack from starting.

# The domain Caddy serves and obtains a certificate for.
REIM_DOMAIN=reim.example.org

# The origins allowed to call the API from a browser. Comma-separated.
# A wildcard here undoes the reason this file exists.
REIM_CORS_ALLOW_ORIGINS=https://reim.example.org

# The database password. Generate one: openssl rand -base64 32
POSTGRES_PASSWORD=

# Contact address Caddy gives its certificate authority so it can warn about
# renewal problems or expiry — unlike the three variables above, this one is
# optional: Caddy issues and renews the certificate without it if left empty.
# Never fill in a real address here.
REIM_ACME_EMAIL=

# Below this line, every variable already has a safe default baked into
# docker-compose.prod.yml (reim.core.config.Settings' own defaults) — unlike
# everything above, leaving these commented out changes nothing. Uncomment
# only to tune them.
#
# Every line below states the values that are legal. Most state a numeric range
# — those are ``ge=``/``le=`` constraints on the matching field in
# reim/core/config.py — and the rest name the words, or the true/false, that
# their field accepts. All of them are enforced and not clamped: a value the
# field rejects does not fall back to the default, it stops the API container
# from starting at all. A misspelled variable *name* has the opposite failure —
# it is ignored in silence and the setting stays at its default. Read "A bad
# value takes the site down" in docs/deployment.md before you change one of
# these and walk away.

# Requests per window an unauthenticated caller may make before a 429.
# Whole number, 1 or more — there is no upper bound, so nothing here stops
# you from setting an allowance that is no allowance at all.
# REIM_RATE_LIMIT_ANONYMOUS=60

# Requests per window a caller presenting a valid API key may make.
# Whole number, 1 or more.
# REIM_RATE_LIMIT_KEYED=600

# Width, in seconds, of the fixed window the two limits above count against.
# Whole number, 1 to 3600.
# REIM_RATE_LIMIT_WINDOW_SECONDS=60

# Webhook REIM posts alert digests to. A Slack or Discord webhook carries its
# posting credential in the URL's own path, so this is a secret — left empty
# here on purpose; never fill in a real URL, and never fill in a
# plausible-looking fake one someone might paste unchanged into a real
# deployment. Unset (empty), alerting still evaluates and reports every run —
# it just delivers nothing.
# REIM_ALERT_WEBHOOK_URL=

# Minimum severity that reaches the webhook: one of info, warning, error,
# critical. Case is normalised, so ERROR is accepted too; any other word is
# not, and stops the container.
# REIM_ALERT_SEVERITY_FLOOR=error

# Hours to wait before repeating a standing alert about the same condition on
# the same pipeline. Whole number, 1 to 720 (30 days).
# REIM_ALERT_REPEAT_HOURS=24

# Hours a pipeline run may sit in 'running' before it's flagged as stuck.
# Whole number, 1 to 168 (7 days).
# REIM_ALERT_STUCK_RUN_HOURS=6

# Rows a page of any list endpoint returns when the caller names no limit.
# Whole number, 1 to 1000.
# REIM_DEFAULT_PAGE_SIZE=100

# The largest page a caller may ask for; a larger ?limit is silently reduced to
# this. Whole number, 1 to 10000.
# REIM_MAX_PAGE_SIZE=1000

# The most rows /api/v1/observations/export.csv will serve in one response, and
# the cap a larger ?limit is reduced to. This is the
# export budget docs/deployment.md tells you to tune. Whole number, 1 or more —
# no upper bound, so nothing stops you from setting a number that returns more
# data per request than you meant to give away.
# REIM_MAX_EXPORT_ROWS=100000

# Whether REIM's own rate limiter runs at all: true or false. Turning it off
# removes every allowance in this file from the request path; do it only when
# something in front of REIM is limiting instead.
# REIM_RATE_LIMIT_ENABLED=true

# Whether /metrics is collected and served: true or false. The Caddyfile
# already answers that path with 404 from outside, so this decides only what an
# in-network scraper would find.
# REIM_METRICS_ENABLED=true

# Connections the API holds open to Postgres, and how many more it may open
# under load. Whole numbers, 1 to 50 and 0 to 50. Their sum must stay inside
# the Postgres server's own max_connections.
# REIM_DATABASE_POOL_SIZE=5
# REIM_DATABASE_MAX_OVERFLOW=10

# Outbound HTTP, used by ingestion when it fetches from a source. Seconds
# before one request is abandoned: a number greater than 0, at most 300.
# REIM_HTTP_TIMEOUT_SECONDS=30

# Retries after the first attempt fails. Whole number, 0 to 10.
# REIM_HTTP_MAX_RETRIES=3

# Multiplier for the exponential backoff between those retries, in seconds:
# a number greater than 0, at most 30.
# REIM_HTTP_RETRY_BACKOFF_SECONDS=1
